# --- Supabase (Project Settings > API) ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...

# --- PowerSync Cloud ---
# https://<instance-id>.powersync.journeyapps.com  (printed by `powersync link cloud --create`)
POWERSYNC_URL=
# Personal access token: https://dashboard.powersync.com/account/access-tokens  (CLI only, never shipped in the app)
PS_ADMIN_TOKEN=

# --- PowerSync replication connection (service.yaml, CLI deploy only) ---
PS_DATABASE_HOST=db.<project-ref>.supabase.co
PS_DATABASE_USER=powersync_role
PS_DATABASE_PASSWORD=
